{
  "name": "memcastle-opencode",
  "private": true,
  "description": "MemCastle lifecycle plugin for OpenCode, over MCP and HTTP only",
  "type": "module",
  "license": "MIT",
  "main": "src/index.ts",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target=node --external '@opencode-ai/*' --external '@opencode/*'",
    "format:check": "python3 scripts/check_format.py",
    "lint": "bun run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 60000",
    "test:cover": "bun test --timeout 60000 --coverage --coverage-reporter=lcov --coverage-dir=coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opencode-ai/plugin": "^1.18.35",
    "smol-toml": "^1.9.0"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.24",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
